# Copie para .env e preencha. O .env NUNCA vai para o repositorio.
# Gerar chave:  python -c "import secrets; print(secrets.token_hex(32))"

# A API conecta com o perfil de menor privilegio, nunca com postgres.
DATABASE_URL=postgresql+psycopg://mufasa_api:TROQUE_AQUI@localhost:5432/mufasa

JWT_SECRET=
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=30

# desenvolvimento | producao
AMBIENTE=desenvolvimento
FORCAR_HTTPS=false
HOSTS_PERMITIDOS=["localhost","127.0.0.1"]
# Endereco do painel (F1). Vazio desliga o CORS.
ORIGENS_CORS=[]
DOCS_HABILITADA=true

# Salario minimo vigente em reais, para o fator financeiro. Confirmar o valor do ano.
SALARIO_MINIMO=
