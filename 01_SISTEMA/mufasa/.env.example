# Modelo do .env. O jeito recomendado de criar o .env e:
#     python -m scripts.configurar            (instalacao local)
#     python -m scripts.configurar --docker   (docker compose)
# que gera senhas e chaves novas. O .env NUNCA vai para o repositorio nem para o zip.

# Dono do banco: so para montar o banco e aplicar migracoes
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:SENHA_DO_POSTGRES@localhost:5432/mufasa
# So no docker: senha do postgres do container (a mesma de DATABASE_URL_ADMIN)
# POSTGRES_SENHA=

# Perfis restritos, um por servico (as senhas sao aplicadas pelo montar_banco)
DATABASE_URL=postgresql+psycopg://mufasa_api:TROQUE_AQUI@localhost:5432/mufasa
CHAT_DATABASE_URL=postgresql+psycopg://mufasa_chat:TROQUE_AQUI@localhost:5432/mufasa
CALCULO_DATABASE_URL=postgresql+psycopg://mufasa_calculo:TROQUE_AQUI@localhost:5432/mufasa

# Gerar:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=30

# Chave dos dados de apoio (cifrados no banco). Perder a chave = perder esses dados.
# Gerar:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APOIO_CHAVE=

# desenvolvimento | producao (em producao as contas *.demo nao entram)
AMBIENTE=desenvolvimento
FORCAR_HTTPS=false
HOSTS_PERMITIDOS=["localhost","127.0.0.1"]
ORIGENS_CORS=[]
DOCS_HABILITADA=true

# Enderecos que o painel usa (docker: http://api:8000 e http://chat:8001)
MUFASA_API_URL=http://127.0.0.1:8000
MUFASA_CHAT_URL=http://127.0.0.1:8001

# Registros: pasta (padrao logs/) e nivel (DEBUG, INFO, WARNING, ERROR)
# MUFASA_LOG_DIR=logs
MUFASA_LOG_NIVEL=INFO
# Opcionais: outro dump do B1 e onde gravar senhas novas (--contas-novas)
# MUFASA_DUMP=
# MUFASA_CREDENCIAIS=credenciais.csv

# Chatbot. Groq opcional: vazio = respostas prontas, nada sai da maquina.
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-20b
CHAT_IA_CLASSIFICAR=false
# Conversa mais livre: a IA recebe a pergunta ANONIMIZADA (sem numero, nome, CPF,
# e-mail, telefone, matricula) e as ultimas perguntas da conversa. Saude nunca vai.
# false = so o rascunho com marcadores, como antes.
CHAT_IA_CONVERSA=true
# Criatividade da redacao (0 = mais previsivel, 1 = mais solta)
GROQ_TEMPERATURA=0.7
# Encerramento por inatividade (SRS C.2: 2 horas)
CHAT_INATIVIDADE_MINUTOS=120
CHAT_JANELA_ATENDIMENTO=no horário de funcionamento da secretaria acadêmica
