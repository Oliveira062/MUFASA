# Copie para .env e preencha. O .env NUNCA vai para o repositorio.
# Gerar chave:  python -c "import secrets; print(secrets.token_hex(32))"

# A API conecta com o perfil de menor privilegio, nunca com postgres.
DATABASE_URL=postgresql+psycopg://mufasa_api:TROQUE_AQUI@localhost:5432/mufasa

JWT_SECRET=
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=30

# desenvolvimento | producao
AMBIENTE=desenvolvimento
FORCAR_HTTPS=false
HOSTS_PERMITIDOS=["localhost","127.0.0.1"]
# Endereco do painel (F1). Vazio desliga o CORS.
ORIGENS_CORS=[]
DOCS_HABILITADA=true

# Salario minimo vigente em reais, para o fator financeiro. Confirmar o valor do ano.
SALARIO_MINIMO=

# ---------------------------------------------------------------------------
# Chatbot (F2)
# ---------------------------------------------------------------------------
# Perfil de banco so do chatbot (sql/chatbot.sql). Obrigatorio em producao.
CHAT_DATABASE_URL=postgresql+psycopg://mufasa_chat:TROQUE_AQUI@localhost:5432/mufasa

# Groq (opcional). Vazio = respostas com os textos prontos, sem servico externo.
# A chave e pessoal da conta do projeto: nunca em codigo, zip ou mensagem.
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-20b
# Classificar pela IA as perguntas que as regras nao reconhecem (envia o texto
# redigido, sem nomes, numeros e contatos). Deixe false se nao houver necessidade.
CHAT_IA_CLASSIFICAR=false

# Texto que completa "o atendimento com uma pessoa da equipe acontece ..." (RF13)
CHAT_JANELA_ATENDIMENTO=no horário de funcionamento da secretaria acadêmica
